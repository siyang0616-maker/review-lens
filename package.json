    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.25.56"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
